# Ngrok Authentication Token
# Get your authtoken from: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=your_ngrok_authtoken_here

# Agent Registration Secret
# This must match the AGENT_REGISTER_SECRET set on your backend (e.g., in Render environment variables)
# Used to authenticate device registration requests
AGENT_REGISTER_SECRET=your_registration_secret_here

# Optional: Clear Data Secret (admin override for clearing backend data)
# If set, this secret can be used instead of device security phrases to clear all devices
CLEAR_DATA_SECRET=your_clear_data_secret_here
