    "auth_type": "oauth2",
    "free": true,
    "mcp_command": "npx",
    "mcp_args": [
      "-y",
      "@mcp-z/mcp-gmail"
    ],
    "fields": [
      {"key": "client_id",     "label": "Google Client ID",     "secret": false},
      {"key": "client_secret", "label": "Google Client Secret", "secret": true}
    ]
  },
  {
    "id": "youtube",
