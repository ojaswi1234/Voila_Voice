  {
    "id": "github",
    "name": "GitHub",
    "description": "GitHub integration",
    "auth_type": "token",
    "free": true,
    "mcp_command": "npx",
    "mcp_args": [
      "-y",
      "@modelcontextprotocol/server-github"
    ],
    "fields": [
      {"key": "token", "label": "Personal Access Token", "secret": true}
    ]
  },
  {
    "id": "gmail",
    "name": "Gmail",
